---
// SlothPack 顶部导航 — 第二批设计系统组件（--sloth-* tokens）
// 品牌标记：public/logo-mark.png（v6 插画头像裁切件，24px 高；来源见 brand/README.md）

const navLinks = [
  { label: '主页', href: '/' },
  { label: '工具库 (tools.slothpack.com)', href: 'https://tools.slothpack.com' },
  { label: '懒人包 (Packs)', href: 'https://tools.slothpack.com/packs' },
  { label: '提交工具', href: 'https://tools.slothpack.com/submit' },
];

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="SlothPack 首页">
      <img class="logo" src="/logo-mark.png" alt="" width="127" height="72" />
    </a>

    <nav class="nav" aria-label="主导航">
      {navLinks.map((link) => (
        <a
          class:list={['nav-link', { active: pathname === link.href }]}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button class="nav-toggle" aria-label="打开菜单" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 72px;
    background-color: color-mix(in srgb, var(--sloth-bg-page) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--sloth-border-light);
  }

  .header-inner {
    max-width: 1200px;
    margin-inline: auto;
    height: 100%;
    padding-inline: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    margin-right: 48px; /* Logo 右侧绝对留白，隔离导航菜单 */
    text-decoration: none;
    color: var(--sloth-text-main);
  }

  .logo {
    display: block;
    height: 24px;
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    align-self: stretch;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    color: var(--sloth-text-sub);
    text-decoration: none;
    transition: color 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .nav-link:hover {
    color: var(--sloth-text-main);
  }

  .nav-link.active {
    color: var(--sloth-text-main);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--sloth-color-moss);
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 768px) {
    .header-inner {
      padding-inline: 16px;
    }

    .nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 8px 16px 16px;
      background-color: color-mix(in srgb, var(--sloth-bg-page) 92%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--sloth-border-light);
    }

    .nav.open {
      display: flex;
    }

    .nav-link {
      width: 100%;
      padding: 12px 0;
      align-self: auto;
    }

    .nav-link.active::after {
      bottom: 6px;
    }

    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
    }

    .bar {
      display: block;
      width: 20px;
      height: 2px;
      background-color: var(--sloth-text-main);
      transition: background-color 300ms;
    }

    .nav-toggle:hover .bar {
      background-color: var(--sloth-color-moss);
    }
  }
</style>
