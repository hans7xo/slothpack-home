---
// SlothPack 主域页脚 —— 与 tools 子域 Footer 保持一致的占位实现
// 注：tools 子域（HTools）代码尚未拿到，先按规格落地，拿到后逐项对齐
const links = [
  { label: '工具', href: 'https://tools.slothpack.com' },
  { label: '分类', href: 'https://tools.slothpack.com/categories' },
  { label: '提交', href: 'https://tools.slothpack.com/submit' },
  { label: '关于', href: 'https://tools.slothpack.com/about' },
  { label: '许可证', href: 'https://tools.slothpack.com/license' },
  { label: '免责声明', href: 'https://tools.slothpack.com/disclaimer' },
  { label: '隐私', href: 'https://tools.slothpack.com/privacy' },
];
---

<footer class="site-footer fade fade-d6">
  <div class="footer-inner">
    <a class="brand" href="/">
      <span class="logo" aria-hidden="true">[LOGO]</span>
      <span class="wordmark">SlothPack</span>
    </a>

    <p class="tagline">We pack. You relax. / 我们打包，你躺平。</p>

    <nav class="footer-links" aria-label="页脚导航">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="contacts">
      <a href="https://t.me/SlothPack">Telegram: @SlothPack</a>
      <a href="mailto:support@slothpack.com">support@slothpack.com</a>
    </div>

    <p class="quiet">Quietly curated.</p>
  </div>
</footer>

<style>
  /* 背景与页面一致，无深色底 */
  .site-footer {
    background: transparent;
    border-top: 1px solid var(--color-border);
    padding: 64px 0 48px;
  }

  .footer-inner {
    max-width: 560px;
    margin-left: 15%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    min-width: 44px;
    padding: 0 6px;
    border: 1px dashed var(--color-border);
    border-radius: 6px;
    background: var(--color-card);
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .tagline {
    margin-top: 16px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 28px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--color-text-muted);
    transition: color 0.25s ease;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .contacts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 28px;
  }

  .contacts a {
    font-size: 13px;
    color: var(--color-text-muted);
    transition: color 0.25s ease;
  }

  .contacts a:hover {
    color: var(--color-accent);
  }

  .quiet {
    margin-top: 32px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 48px 0 40px;
    }
    .footer-inner {
      max-width: none;
      margin-left: 8%;
      margin-right: 8%;
    }
  }
</style>
