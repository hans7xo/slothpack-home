---
// SlothPack 页脚 — 第二批设计系统组件（--sloth-* tokens）
// 极简、低存在感；链接指向 tools 子域对应页面

const links = [
  { label: '主页', href: '/' },
  { label: '工具导航', href: 'https://tools.slothpack.com' },
  { label: '提交工具', href: 'https://tools.slothpack.com/submit' },
  { label: '关于', href: 'https://tools.slothpack.com/about' },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="SlothPack 首页">
        <img class="logo" src="/logo-mark.png" alt="" width="127" height="72" />
        <span class="wordmark">SlothPack</span>
      </a>
      <p class="slogan">We pack. You relax. / 我们打包，你躺平。</p>
      <p class="copyright">© SlothPack</p>
    </div>

    <nav class="footer-links" aria-label="页脚导航">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sloth-border-light);
  }

  .footer-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--sloth-space-2xl) 24px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--sloth-text-main);
  }

  .logo {
    display: block;
    height: 24px;
    width: auto;
  }

  .wordmark {
    font-size: 16px;
    font-weight: 500;
    color: var(--sloth-text-main);
  }

  .slogan {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--sloth-text-sub);
  }

  .copyright {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--sloth-text-disabled);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 24px;
  }

  .footer-links a {
    font-size: 14px;
    color: var(--sloth-text-sub);
    text-decoration: none;
    transition: color 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .footer-links a:hover {
    color: var(--sloth-color-moss);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--sloth-space-2xl) 16px;
    }

    .footer-links {
      justify-content: flex-start;
      gap: 16px 24px;
    }
  }
</style>
