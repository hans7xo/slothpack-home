---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SlothPack — A quiet tool library for lazy creators.',
  description = '懒人创作者的工具站。We pack. You relax.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- 共享设计令牌（--color-* 旧体系，global.css 依赖；tools 子域跨域直引同一文件） -->
    <link rel="stylesheet" href="/css-variables.css" />

    <!-- 字体：Inter + Noto Sans SC，font-display: swap
         （字体加载期间使用系统 fallback，避免布局跳动） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+SC:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main class="layout-main">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>

<style>
  .layout-main {
    max-width: 1200px;
    margin-inline: auto;
    margin-top: var(--sloth-space-2xl);
    margin-bottom: var(--sloth-space-3xl);
    padding-inline: 24px;
  }

  @media (max-width: 768px) {
    .layout-main {
      padding-inline: 16px;
    }
  }
</style>
