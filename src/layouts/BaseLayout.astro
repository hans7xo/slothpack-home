---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  /** 不参与搜索索引的页面（如 404 兜底页）传 true */
  noindex?: boolean;
  /** 社交分享图路径，默认站点统一图 */
  ogImage?: string;
}

const {
  title = 'SlothPack — A quiet tool library for lazy creators.',
  description = '懒人创作者的工具站。We pack. You relax.',
  noindex = false,
  ogImage = '/og-image.png',
} = Astro.props;

const SITE = Astro.site ?? new URL('https://slothpack.com');
// canonical 与 og:url 一律使用根域，避免 www 与根域被判为重复内容
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
const siteName = 'SlothPack';
const siteUrl = SITE.href;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- 索引策略：404 兜底页 noindex；首页 index -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F5F1E8" />

    <!-- Open Graph（Telegram / Facebook / 微信等分享卡片） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={noindex ? siteUrl : canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SlothPack — We pack. You relax." />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 结构化数据（仅可索引页面输出） -->
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: siteName,
          url: siteUrl,
          description,
          inLanguage: 'zh-CN',
          publisher: {
            '@type': 'Organization',
            name: siteName,
            url: siteUrl,
            logo: { '@type': 'ImageObject', url: new URL('/logo-mark.png', SITE).href },
            sameAs: ['https://t.me/SlothPack'],
          },
        })}
      />
    )}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- 共享设计令牌（--color-* 旧体系，global.css 依赖；tools 子域跨域直引同一文件） -->
    <link rel="stylesheet" href="/css-variables.css" />

    <!-- 字体：Inter + Noto Sans SC，font-display: swap
         （字体加载期间使用系统 fallback，避免布局跳动） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+SC:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main class="layout-main">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>

<style>
  .layout-main {
    max-width: 1200px;
    margin-inline: auto;
    margin-top: var(--sloth-space-2xl);
    margin-bottom: var(--sloth-space-3xl);
    padding-inline: 24px;
  }

  @media (max-width: 768px) {
    .layout-main {
      padding-inline: 16px;
    }
  }
</style>
