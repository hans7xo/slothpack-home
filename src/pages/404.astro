---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — SlothPack" description="迷路了？慢慢来。Take your time.">
  <!-- 404：延续信纸布局，不着急、不催促 -->
  <main class="letter">
    <p class="missing fade fade-d0">迷路了？慢慢来。</p>
    <p class="take-it-slow fade fade-d1">Take your time.</p>
    <p class="home-link fade fade-d2">
      <a href="/">返回首页 →</a>
    </p>
  </main>
</BaseLayout>

<style>
  /* 与首页同款信纸布局：40% 宽 / 560px 上限 / 左对齐 / 大留白 */
  .letter {
    max-width: 560px;
    width: 40%;
    margin-left: 15%;
    margin-right: auto;
    padding: 240px 0;
    min-height: 60vh;
  }

  .missing {
    font-size: 32px;
    line-height: 1.6;
  }

  .take-it-slow {
    margin-top: 16px;
    font-family: var(--font-heading);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .home-link {
    margin-top: 120px;
  }

  .home-link a {
    font-family: var(--font-heading);
    font-size: 15px;
    color: var(--color-accent);
  }

  .home-link a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 768px) {
    .letter {
      width: auto;
      max-width: none;
      margin-left: 8%;
      margin-right: 8%;
      padding: 120px 0;
    }
    .missing {
      font-size: 26px;
    }
    .home-link {
      margin-top: 80px;
    }
  }
</style>
